<Application
    x:Class="WireTunnels.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
            <!-- Monospaced text boxes keep a regular-font header. -->
            <DataTemplate x:Key="PlainHeader">
                <TextBlock Text="{Binding}" FontFamily="{ThemeResource ContentControlThemeFontFamily}" />
            </DataTemplate>
            <!-- The macOS accent (AccentColor.colorset) replaces the Windows accent in every control. -->
            <Color x:Key="SystemAccentColor">#7C4DFF</Color>
            <Color x:Key="SystemAccentColorLight1">#9670FF</Color>
            <Color x:Key="SystemAccentColorLight2">#B094FF</Color>
            <Color x:Key="SystemAccentColorLight3">#CAB8FF</Color>
            <Color x:Key="SystemAccentColorDark1">#6129FF</Color>
            <Color x:Key="SystemAccentColorDark2">#4300FF</Color>
            <Color x:Key="SystemAccentColorDark3">#3900D6</Color>
            <!-- macOS system colours; Services/MacPalette.cs sets the light or dark value at start and on theme change. -->
            <SolidColorBrush x:Key="ConnectedBrush" Color="#34C759" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9500" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#FF3B30" />
            <SolidColorBrush x:Key="RxBrush" Color="#34C759" />
            <SolidColorBrush x:Key="TxBrush" Color="#007AFF" />
            <SolidColorBrush x:Key="YellowBrush" Color="#FFCC00" />
            <SolidColorBrush x:Key="PurpleBrush" Color="#AF52DE" />
            <SolidColorBrush x:Key="IndigoBrush" Color="#5856D6" />
            <SolidColorBrush x:Key="TealBrush" Color="#30B0C7" />
            <SolidColorBrush x:Key="GrayBrush" Color="#8E8E93" />

            <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Width" Value="140" />
            </Style>
            <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
