<Project Sdk="Microsoft.NET.Sdk">

  <!-- WinUI 3 app (phase 3): tray icon + flyout and the dashboard. Unpackaged and self-contained
       (Windows App SDK runtime shipped next to the exe), so the MSI needs no extra runtime installer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WireTunnels.App</RootNamespace>
    <!-- Not "WireTunnels": NTFS is case-insensitive and the CLI is wiretunnels.exe/.dll in the same folder. -->
    <AssemblyName>WireTunnels.App</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without it `dotnet publish` of an unpackaged app drops WireTunnels.App.pri and the compiled XAML (.xbf). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- LibraryImport (user32) -->
    <!-- Program.cs owns Main: single instance before any window exists. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- 2.4 requires .NET 10; 2.3.2 is the last release for .NET 8. -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WireTunnels.Client\WireTunnels.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app-256.png" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="Assets\make-icons.ps1" />
  </ItemGroup>
</Project>
