 del_dns() {
+	if [[ -n ${WIRETUNNELS_DNS_HELPER:-} ]]; then
+		[[ -n ${WIRETUNNELS_DNS_TOKEN:-} ]] || return 1
+		cmd "$WIRETUNNELS_DNS_HELPER" --dns-release "$WIRETUNNELS_DNS_TOKEN"
+		return $?
+	fi
 	local i service response
 	for i in "${!SERVICE_NAMES[@]}"; do
