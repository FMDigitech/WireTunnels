<Window
    x:Class="WireTunnels.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WireTunnels.App.Views"
    xmlns:vm="using:WireTunnels.App.ViewModels"
    Title="WireTunnels">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Height="40" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="WireTunnels" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" OpenPaneLength="230"
                        IsSettingsVisible="True" SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="All Tunnels" Tag="All" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Active" Tag="Active">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE945;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.ActiveCount, Mode=OneWay}" Background="{StaticResource ConnectedBrush}"
                                   Visibility="{x:Bind local:Bind.VisibleIfPositive(ViewModel.ActiveCount), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Shared" Tag="Shared">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE716;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Favorites" Tag="Favorites">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.FavoriteCount, Mode=OneWay}" Style="{StaticResource AttentionValueInfoBadgeStyle}"
                                   Visibility="{x:Bind local:Bind.VisibleIfPositive(ViewModel.FavoriteCount), Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Multi-Hop" Tag="MultiHop">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8AB;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Warnings" Tag="Warnings">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.WarningCount, Mode=OneWay}" Background="{StaticResource WarningBrush}"
                                   Visibility="{x:Bind ViewModel.HasWarnings, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Log" Tag="Log">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <InfoBar Margin="16,8,16,0" Severity="Error" Title="WireTunnels Error"
                         IsOpen="{x:Bind local:Bind.IsSet(ViewModel.Manager.ErrorMessage), Mode=OneWay}"
                         Message="{x:Bind local:Bind.Text(ViewModel.Manager.ErrorMessage), Mode=OneWay}"
                         CloseButtonClick="OnErrorClosed" />

                <!-- Tunnels: list + detail -->
                <Grid x:Name="TunnelsPage" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" MinWidth="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="16,12,8,8">
                            <StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SectionTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SectionSubtitle, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnImport" ToolTipService.ToolTip="Import a .conf file"
                                        AutomationProperties.Name="Import Config">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" />
                                </Button>
                                <Button Style="{StaticResource SubtleButtonStyle}" Click="OnNewTunnel" ToolTipService.ToolTip="Create a new tunnel"
                                        AutomationProperties.Name="New Tunnel">
                                    <FontIcon Glyph="&#xE710;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ListView x:Name="TunnelList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.VisibleItems}" SelectionMode="Single"
                                  SelectionChanged="OnTunnelSelected" Padding="4,0,4,8" AutomationProperties.Name="Tunnels">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:TunnelItem">
                                    <Grid Padding="0,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Duplicate Tunnel" Click="OnDuplicate" IsEnabled="{x:Bind IsPersonal, Mode=OneWay}">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{x:Bind StatusBrush, Mode=OneWay}" />
                                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsBusy, Mode=OneWay}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                                <FontIcon Glyph="&#xE735;" FontSize="11" Foreground="{StaticResource WarningBrush}" Visibility="{x:Bind IsFavorite, Mode=OneWay}" />
                                                <FontIcon Glyph="&#xE72E;" FontSize="11" Visibility="{x:Bind IsShared, Mode=OneWay}" ToolTipService.ToolTip="Shared" />
                                                <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{StaticResource WarningBrush}" Visibility="{x:Bind HasWarning, Mode=OneWay}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Endpoint, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind HasEndpoint, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind AllowedIPs, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind HasAllowedIPs, Mode=OneWay}" />
                                        </StackPanel>
                                        <local:Sparkline Grid.Column="2" Width="44" Height="22" Values="{x:Bind TotalSamples, Mode=OneWay}"
                                                         Stroke="{StaticResource ConnectedBrush}" Visibility="{x:Bind HasTraffic, Mode=OneWay}" />
                                        <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Padding="6" Click="OnFavorite" VerticalAlignment="Center"
                                                Visibility="{x:Bind IsPersonal, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind FavoriteLabel, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind FavoriteLabel, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" FontSize="14" />
                                        </Button>
                                        <ToggleSwitch Grid.Column="4" MinWidth="0" OnContent="" OffContent="" Margin="0,0,-12,0" VerticalAlignment="Center"
                                                      IsOn="{x:Bind IsActive, Mode=OneWay}" IsEnabled="{x:Bind CanToggle, Mode=OneWay}" Toggled="OnToggled"
                                                      ToolTipService.ToolTip="{x:Bind ToggleHint, Mode=OneWay}" AutomationProperties.Name="{x:Bind ToggleHint, Mode=OneWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="24"
                                    Visibility="{x:Bind ViewModel.IsSectionEmpty, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind ViewModel.EmptyGlyph, Mode=OneWay}" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <local:TunnelDetailView x:Name="Detail" Grid.Column="1" Visibility="Collapsed" />
                    <StackPanel x:Name="NoSelection" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE968;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Select a tunnel" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Choose a tunnel from the list to view its details." Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Warnings -->
                <Grid x:Name="WarningsPage" Grid.Row="1" Visibility="Collapsed" Padding="24,16">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Visibility="{x:Bind local:Bind.CollapsedIf(ViewModel.HasWarnings), Mode=OneWay}">
                        <FontIcon Glyph="&#xEA18;" FontSize="40" Foreground="{StaticResource ConnectedBrush}" />
                        <TextBlock Text="No Warnings" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock Text="Your tunnel configuration looks good." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasWarnings, Mode=OneWay}">
                        <TextBlock Text="Warnings" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.WarningItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WarningItem">
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{StaticResource WarningBrush}" />
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <local:MultiHopView x:Name="MultiHopPage" Grid.Row="1" Visibility="Collapsed" />

                <local:LogView x:Name="LogPage" Grid.Row="1" Visibility="Collapsed" />
                <local:SettingsView x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" />

                <!-- Setup wizard: shown until the service is installed, running and compatible. -->
                <Grid x:Name="SetupOverlay" Grid.RowSpan="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Spacing="18" Padding="32">
                        <Image x:Name="SetupIcon" Width="56" Height="56" />
                        <StackPanel x:Name="SetupLoading" Spacing="12" HorizontalAlignment="Center">
                            <ProgressRing IsActive="True" Width="32" Height="32" />
                            <TextBlock Text="Starting upâ€¦" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="SetupSteps" Spacing="14">
                            <TextBlock Text="Quick Setup Required" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="WireTunnels needs its Windows service to create and manage WireGuard adapters securely." />
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon x:Name="SetupStateIcon" Glyph="&#xE7BA;" Foreground="{StaticResource WarningBrush}" />
                                        <TextBlock x:Name="SetupTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="SetupMessage" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="SetupStart" Content="Start Service" Style="{StaticResource AccentButtonStyle}" Click="OnStartService" />
                                        <Button Content="Check Again" Click="OnCheckService" />
                                        <ProgressRing x:Name="SetupBusy" Width="18" Height="18" IsActive="False" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
