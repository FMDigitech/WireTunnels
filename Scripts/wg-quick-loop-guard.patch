+has_static_host_route() {
+	local family=inet destination flags
+	[[ $1 == *:* ]] && family=inet6
+	while read -r destination _ flags _; do
+		[[ $destination == "$1" && $flags == *H* && $flags == *S* ]] && return 0
+	done < <(netstat -nr -f $family)
+	return 1
+}
+
+# If a route ever sends wireguard-go's own UDP packets back into the tunnel, each
+# pass encapsulates them again and the loop saturates the CPU. Only wireguard-go
+# can send from its listen port, so drop those packets on the tunnel interface.
+# The port is fixed for the session, so this holds even when the endpoint roams.
+# Anchors under com.apple/* run in name order, ahead of wiretunnels.killswitch.
+set_loop_guard() {
+	local port="" i
+	# wireguard-go picks a port only once the interface is up.
+	for ((i = 0; i < 40; ++i)); do
+		port="$(wg show "$REAL_INTERFACE" listen-port 2>/dev/null)" || port=""
+		[[ $port =~ ^[0-9]+$ && $port -gt 0 ]] && break
+		port=""
+		sleep 0.05
+	done
+	if [[ -z $port ]]; then
+		echo "[!] Listen port unknown; routing loop guard not installed" >&2
+		return 0
+	fi
+	if ! echo "block drop out quick on $REAL_INTERFACE proto udp from any port $port" | cmd pfctl -q -a "com.apple/wiretunnels.guard.$REAL_INTERFACE" -f -; then
+		echo "[!] Unable to load routing loop guard" >&2
+		return 0
+	fi
+	# Never disabled again: PF is shared, same as the kill switch.
+	cmd pfctl -q -e >/dev/null 2>&1 || true
+}
+
+del_loop_guard() {
+	[[ -n $REAL_INTERFACE ]] || return 0
+	cmd pfctl -q -a "com.apple/wiretunnels.guard.$REAL_INTERFACE" -F all >/dev/null 2>&1 || true
+}
+
